generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  GLOBAL_ADMIN
  TRAINER
  LEARNER
}
enum ScenarioCategory {
  PHISHING
  SMISHING
  VISHING
  SOCIAL_ENGINEERING
  MALWARE
  RANSONWARE
  BUISINESS_EMAIL_COMPROMISE
  SPEAR_PHISHING
  WHALING
}

enum ScenarioDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ScenarionInteractionType {
  EMAIL
  TEXT_MESSAGE
  PHONE_CALL
  SOCIAL_MEDIA
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CueTag {
  URGENCY
  MISMATCHED_DOMAIN
  UNEXPECTED_ATTACHMENT
  SUSPICIOUS_LINK
  AUTHORITY_IMPERSONATION
  SPELLING_GRAMMAR
  GENERIC_GREETING
  OTHER
}

model Organisation {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  modules Module[]
  users   User[]
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  firstName       String
  lastName        String
  email           String           @unique
  passwordHash    String
  role            Role             @default(LEARNER)
  organisationId  Int?
  moduleResults   ModuleResults[]
  organisation    Organisation?     @relation(fields: [organisationId], references: [id])

  @@index([organisationId], map: "User_organisationId_fkey")
}

model Module {
  id              Int              @id @default(autoincrement())
  title           String
  description     String
  createdAt       DateTime         @default(now())
  organisationId  Int
  assignedUsers   Json?           //array list of userId's
  organisation    Organisation     @relation(fields: [organisationId], references: [id])
  scenarios       Scenario[]
  scenarioAttempts ScenarioAttempt[]
  moduleResults   ModuleResults[]

  @@index([organisationId], map: "Module_organisationId_fkey")
}

model Scenario {
  id                       Int                  @id @default(autoincrement())
  moduleId                 Int
  title                    String
  content                  String               @db.VarChar(1000)
  category                 ScenarioCategory
  difficulty               ScenarioDifficulty
  interactionType          ScenarionInteractionType
  scenarioDescription      String               @db.VarChar(1000)
  sender                   String?              @db.VarChar(250)
  recipient                String?              @db.VarChar(250)
  subject                  String?              @db.VarChar(250)
  correctActionExplanation String?              @default("Explanations coming soon") @db.VarChar(1000)
  createdAt                DateTime             @default(now())
  module                   Module               @relation(fields: [moduleId], references: [id])
  scenarioAttempts         ScenarioAttempt[]
  correctAnswer            Json?
  correctCues              Json

  @@index([moduleId], map: "Scenario_moduleId_fkey")
}

model ScenarioAttempt {
  id                  Int             @id @default(autoincrement())
  moduleResultId      Int
  scenarioId          Int
  moduleId            Int
  isCorrect           Boolean
  timeTakenSeconds    Int
  attemptNumber       Int
  response            String
  score               Int
  startedAt           DateTime
  completedAt         DateTime
  selectedChoice      Int?
  selectedChoiceText  String?
  createdAt           DateTime        @default(now())
  cueSelections       Json?
  missedCues          Json?
  module              Module          @relation(fields:[moduleId], references:[id])
  moduleResult        ModuleResults   @relation(fields: [moduleResultId], references: [id])
  scenario         Scenario        @relation(fields: [scenarioId], references: [id])

  @@index([moduleResultId], map: "ScenarioAttempt_moduleResultId_fkey")
  @@index([scenarioId], map: "ScenarioAttempt_scenarioId_fkey")
  @@index([moduleId], map: "ScenarioAttempt_moduleId_fkey")
}

model ModuleResults {
  id                    Int               @id @default(autoincrement())
  userId                Int
  moduleId              Int
  organisationId        Int
  status                Status
  total_score           Int
  max_possible_score    Int
  percentage_score      Int
  scenarios_completed   Int
  total_scenarios       Int
  passed                Boolean //has the user scored =>80% for the module
  feedback              String            @db.VarChar(1000)
  createdAt             DateTime          @default(now())
  startedAt             DateTime?
  completedAt           DateTime?         
  updatedAt             DateTime          @updatedAt
  module                Module              @relation(fields: [moduleId], references: [id])
  user                  User                @relation(fields: [userId], references: [id])
  scenarioAttempts      ScenarioAttempt[]

  @@index([userId], map: "ModuleResults_userId_fkey")
  @@index([moduleId], map: "ModuleResults_moduleId_fkey")
}
